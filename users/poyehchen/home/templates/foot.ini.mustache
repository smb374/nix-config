[colors-dark]
foreground={{hex.fg}}
background={{hex.bg}}
selection-foreground={{hex.bg}}
selection-background={{hex.accent}}
# Text under the cursor, then the cursor.
cursor={{hex.bg}} {{hex.fg}}
urls={{hex.cyan}}

# Terminal colors 0-15, per the base24 styling spec.
regular0={{hex.bg}}
regular1={{hex.red}}
regular2={{hex.green}}
regular3={{hex.yellow}}
regular4={{hex.blue}}
regular5={{hex.magenta}}
regular6={{hex.cyan}}
regular7={{hex.fg}}
bright0={{hex.bgHighest}}
bright1={{hex.brightRed}}
bright2={{hex.brightGreen}}
bright3={{hex.brightYellow}}
bright4={{hex.brightBlue}}
bright5={{hex.brightMagenta}}
bright6={{hex.brightCyan}}
bright7={{hex.bright}}
